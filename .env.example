# Copie para .env (ignorado pelo git) para uso local.
# Em CI ou sessao na nuvem, use as variaveis do ambiente, nunca um arquivo.
#
# Na sua maquina, `npm run setup:local` gera este arquivo automaticamente.

# Conta que o wrangler deve usar. E a trava real contra deploy na conta errada.
CLOUDFLARE_ACCOUNT_ID=6939ad4db2ec5dc60b8d7c57b7e6faab

# Conta que a guarda espera. Normalmente igual a CLOUDFLARE_ACCOUNT_ID.
CF_EXPECTED_ACCOUNT_ID=6939ad4db2ec5dc60b8d7c57b7e6faab

# Opcional: e-mail dono da credencial.
CF_EXPECTED_EMAIL=allan.em.cristo.jesus@gmail.com

# Apenas em CI/container, onde nao ha navegador para o `wrangler login`.
# Na sua maquina isto fica VAZIO: a sessao OAuth vive em ~/.config/.wrangler.
CLOUDFLARE_API_TOKEN=
