# Copie para .env (que e ignorado pelo git) apenas para uso local.
# Em sessoes na nuvem, defina isto nas variaveis do ambiente, nao em arquivo.

# Token gerado DENTRO da conta de destino.
# My Profile -> API Tokens -> template "Edit Cloudflare Workers"
# + escopo User -> User Details: Read (para a guarda checar o e-mail)
CLOUDFLARE_API_TOKEN=

# Conta que o wrangler deve usar. Trava real contra deploy na conta errada.
CLOUDFLARE_ACCOUNT_ID=

# Conta que a guarda espera. Normalmente igual a CLOUDFLARE_ACCOUNT_ID.
CF_EXPECTED_ACCOUNT_ID=

# Opcional: e-mail dono da credencial.
CF_EXPECTED_EMAIL=allan.em.cristo.jesus@gmail.com
