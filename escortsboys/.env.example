# URL pública do site (canonical, sitemap, Open Graph)
SITE_URL=http://localhost:3000

# Segredo para assinar tokens (gere com: openssl rand -hex 32). Obrigatório em produção.
SESSION_SECRET=

# Administrador inicial criado no primeiro boot do armazenamento local
ADMIN_EMAIL=admin@escortsboys.local
ADMIN_PASSWORD=

# Adaptador de dados: "local" (arquivo JSON em .data/, para desenvolvimento) ou "supabase"
DATA_ADAPTER=local

# Supabase (apenas no servidor; nunca exponha a service role no navegador)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Envio de e-mail transacional (recuperação de senha). Sem isso, o link é registrado no log do servidor em desenvolvimento.
EMAIL_FROM=
RESEND_API_KEY=

# Exibir anúncios demonstrativos (sempre marcados como "Exemplo")
SEED_DEMO=true
